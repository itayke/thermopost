# Consulted only when there is no `sdkconfig`. To re-apply after a build:
#   rm sdkconfig && idf.py build
#
# LVGL, Wi-Fi and LittleFS options land here as their milestones do — adding a
# CONFIG_LV_* / CONFIG_ESP_WIFI_* key before the component that defines it is a
# dependency produces an "unknown config" warning and is silently ignored.

# --- Target ---
CONFIG_IDF_TARGET="esp32s3"

# --- Flash & PSRAM (ESP32-S3 N16R8: 16MB QIO flash + 8MB OPI PSRAM) ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- Custom partition table (see partitions.csv) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- Console ---
# The Type-C port is the ESP32-S3's *native* USB-Serial-JTAG, not a bridge chip:
# it enumerates as /dev/cu.usbmodem* (a bridge would be usbserial/wchusbserial),
# and the boot log reports `rst:0x15 (USB_UART_CHIP_RESET)`, a reset cause only
# the USB-Serial-JTAG peripheral can raise. So it is the primary console — the
# secondary mirror can only write, and the serial REPL needs to read keystrokes.
#
# Consequence for the power work: entering deep sleep drops the USB device, so
# the monitor disconnects on every sleep cycle and must reattach on wake.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

# --- C++ ---
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# --- FreeRTOS tick at 1kHz so LVGL animations stay smooth ---
CONFIG_FREERTOS_HZ=1000

# --- LVGL memory: custom allocator backed by PSRAM (components/display/lv_port_mem.c) ---
# LVGL's pool, style data and image buffers are CPU-only — the final pixels land
# in display.cpp's draw buffers, never in LVGL's pool — so they live in PSRAM.
# That matters because the SPI master can only DMA color data out of INTERNAL
# RAM, so the two 25 KB draw buffers must stay internal; a fixed internal LVGL
# pool on top of those plus the Wi-Fi stack gets tight. Custom malloc also
# removes the fixed-pool ceiling: allocations grow into the 8 MB PSRAM as
# screens are built and torn down.
CONFIG_LV_USE_CUSTOM_MALLOC=y

# --- LVGL fonts ---
# Only Montserrat 14 is built by default; every other size has to be requested
# here or the linker can't find it. The UI never names a face directly — these
# back the three roles in ui_theme.hpp, which is where a swap is made:
#   14 pt — kFontBody: captions, chips, footers, the status strip
#   20 pt — kFontTitle: headings and every button label
#   42 pt — kFontReadout: the main screen's temperature
# Each size costs flash for its whole glyph range — about 6 KB at 14 pt, 9 KB at
# 20 and 39 KB at 42 — so enabling a size nothing points at is pure image growth.
#
# A different typeface is not a Kconfig switch: convert the TTF with lv_font_conv
# (`--font X.ttf --size 20 --bpp 4 --range 0x20-0x7F --format lvgl -o x_20.c`),
# drop the .c under components/ui/, declare it extern, and point the role at it.
# Two things to get right. Keep --bpp 4: the 1-bit output aliases badly at this
# size on a 320x240 panel. And merge FontAwesome in the same command — LV_SYMBOL_*
# are icon-font codepoints that LVGL's own Montserrat builds carry, not characters
# any text TTF has, so a plain conversion drops the stepper's +/- and the threshold
# arrows to empty boxes. Only those four glyphs are used, so the second --range
# can be exactly them rather than the whole icon set.
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_42=y

# --- LVGL QR code widget ---
# The Configure page draws a WIFI: QR that joins the post's setup AP, so a phone
# provisions it without anyone typing a network name. The encoder is vendored with
# LVGL and costs nothing until this is on.
CONFIG_LV_USE_QRCODE=y
